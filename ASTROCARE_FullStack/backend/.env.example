PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/astrocare
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@astrocare.local
ADMIN_PASSWORD=change-this-demo-password

# Email notifications (Gmail: use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=ASTROCARE <your-email@gmail.com>
ALERT_EMAIL=mission-control-email@gmail.com
